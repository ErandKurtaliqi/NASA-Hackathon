          "height": 554,
          "credit": "Image supplied in the LM-5 package"
        },
        {
          "id": "lm5-1-1-2",
          "src": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTVw1uyKUMmHPuae2mWI-zW7c5jCnZ0BOsKYA9FN-uicg&s=10",
