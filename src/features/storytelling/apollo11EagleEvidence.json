  [
    {
      "title": "Time to Leave",
      "text": "On July 21, 1969. After spending 21 hours on the Moon, it was time to leave. Neil and Buzz climbed aboard my upper stage, they were ready to leave the world where history had been made.",
      "gallery": [
        {
          "id": "lm5-4-1-1",
          "src": "https://www.nasa.gov/wp-content/uploads/static/history/ap11ann/kippsphotos/5528.jpg",
          "sourceUrl": "https://www.nasa.gov/wp-content/uploads/static/history/ap11ann/kippsphotos/5528.jpg",
          "title": "Apollo 11 departure archive",
          "caption": "Apollo 11 departure archive.",
          "alt": "Apollo 11 departure archive",
          "width": 800,
          "height": 637,
          "credit": "NASA"
        }
      ]
    },
    {
      "title": "One Half Stays Behind",
      "text": "My engine roared to life, and I began to rise. But my lower half stayed behind on the Moon. For the first time, Eagle became two, each left with a different journey.",
      "gallery": [
        {
          "id": "lm5-4-2-1",
          "src": "https://cdn.mos.cms.futurecdn.net/FBLaiG6iGK8TEmmDp4vqqU.jpg",
          "sourceUrl": "https://cdn.mos.cms.futurecdn.net/FBLaiG6iGK8TEmmDp4vqqU.jpg",
          "title": "Eagle’s descent stage",
          "caption": "Eagle’s descent stage.",
          "alt": "Eagle’s descent stage",
          "width": 2000,
          "height": 1440,
          "credit": "Image supplied in the LM-5 package"
        }
      ]
    },
    {
      "title": "Back Together Again",
      "text": "After reaching lunar orbit, I found Columbia waiting for us. Neil and Buzz reunited with Michael Collins, bringing their Moon samples aboard. Their journey home could now begin, but the journey of Descent Stage was ended.",
